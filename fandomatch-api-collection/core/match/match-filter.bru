meta {
  name: match/filter
  type: http
  seq: 2
}

post {
  url: {{uat_host}}/core/match/filter
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "filters": {
      "gender": [
        "FEMALE"
      ],
      "age_from": 18,
      "age_to": 35,
      "only_in_user_city": true,
      "fandom_category": [
        "ANIME_MANGA"
      ]
    }
  }
}
