meta {
  name: core/user/preferences
  type: http
  seq: 2
}

patch {
  url: http://localhost:8080/core/user/preferences
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "match_notifications_enabled": true,
    "message_notifications_enabled": true,
    "hide_my_posts_from_non_matches": false
  }
}
