meta {
  name: auth/change-password
  type: http
  seq: 3
}

post {
  url: http://localhost:8080/auth/change-password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "old_password": "$2a$10$...",
    "new_password": "new_pass"
  }
}

