meta {
  name: auth/reset-password
  type: http
  seq: 5
}

post {
  url: http://localhost:8080/auth/reset-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "email": "user@example.com",
    "code": "123456",
    "new_password": "newSecurePassword123"
  }
}
