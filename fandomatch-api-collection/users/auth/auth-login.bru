meta {
  name: auth/login
  type: http
  seq: 1
}

post {
  url: {{prod_host}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "maraa",
    "hashed_password": "qwerty123!"
  }
}

vars:post-response {
  ~token: 
}

script:post-response {
  if (res.body.successResponse != null) {
    bru.setVar("token", res.body.successResponse.access_token);
    bru.setVar("cur_uuid", res.body.successResponse.uuid);
  }
}
