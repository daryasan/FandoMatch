meta {
  name: Set Filters
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/core/match/filter
  body: none
  auth: none
}

headers {
  Authorization: {{auth_token}}
  Content-Type: application/json
}

body:json {
  {"filters":{"gender":["FEMALE"],"age_from":18,"age_to":35,"only_in_user_city":false,"fandom_category":["ANIME_MANGA"]}}
}
