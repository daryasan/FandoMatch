meta {
  id: core-edit-profile
  name: Edit Profile
  type: http
  method: PATCH
}

patch {
  url: http://localhost:8080/core/user/profile/edit
}

headers {
Authorization: {{auth_token}}
  Content-Type: application/json
}

body:json {
  {"bio":"Updated bio","name":"NewName","gender":"OTHER","city":{"name_en":"Moscow","name_ru":"Москва"}}
}

